; EVERBLOOM — original 3D life-simulation project.
config_version=5

[application]
config/name="EVERBLOOM: The Living Valley"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Original painterly valley farming and relationship sim"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.66, 0.82, 0.94, 1)
